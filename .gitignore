# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# dumps/*.bin and *.hex (this project's own extracted config/firmware backups) are
# deliberately NOT excluded here (whitelisted 2026-09-07, see AGENTS.md's Publishing
